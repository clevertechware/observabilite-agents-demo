# Copier vers config.env (ignoré par git), puis renseigner les valeurs.
O2_HOST=o2.example.com
ALLOWED_IPV4=203.0.113.10/32
ALLOWED_IPV6=2001:db8:1234:5678::/64
# tofu output -raw private_network_cidr
PRIVATE_NETWORK_CIDR=172.16.0.0/22
# tofu output -raw pod_cidr
PODS_CIDR=100.64.0.0/16
# tofu output -raw lb_ip_id,lb_ipv6_id, séparés par une virgule
LB_IP_IDS=00000000-0000-0000-0000-000000000000,00000000-0000-0000-0000-000000000001
