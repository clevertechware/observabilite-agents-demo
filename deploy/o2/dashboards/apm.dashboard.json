{
  "dashboardId": "apm",
  "version": 8,
  "title": "APM",
  "description": "Santé des services de la démo : CPU, mémoire, latence, débit, réseau et disque",
  "variables": {
    "list": [
      {
        "type": "query_values",
        "name": "namespace_name",
        "label": "namespace_name",
        "query_data": {
          "stream_type": "metrics",
          "stream": "k8s_pod_cpu_usage",
          "field": "k8s_namespace_name",
          "max_record_size": 50,
          "filter": []
        },
        "value": "",
        "multiSelect": true,
        "selectAllValueForMultiSelect": "all"
      },
      {
        "type": "query_values",
        "name": "deployment_name",
        "label": "deployment_name",
        "query_data": {
          "stream_type": "metrics",
          "stream": "k8s_pod_cpu_usage",
          "field": "k8s_deployment_name",
          "max_record_size": 50,
          "filter": [
            {
              "name": "k8s_namespace_name",
              "operator": "IN",
              "value": "$namespace_name"
            }
          ]
        },
        "value": "",
        "multiSelect": true,
        "selectAllValueForMultiSelect": "all"
      },
      {
        "type": "query_values",
        "name": "instance",
        "label": "instance",
        "query_data": {
          "stream_type": "metrics",
          "stream": "k8s_pod_cpu_usage",
          "field": "k8s_pod_name",
          "max_record_size": 50,
          "filter": [
            {
              "name": "k8s_deployment_name",
              "operator": "IN",
              "value": "$deployment_name"
            },
            {
              "name": "k8s_namespace_name",
              "operator": "IN",
              "value": "$namespace_name"
            }
          ]
        },
        "value": "",
        "multiSelect": true,
        "selectAllValueForMultiSelect": "all"
      }
    ],
    "showDynamicFilters": false
  },
